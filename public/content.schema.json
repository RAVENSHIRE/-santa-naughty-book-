{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "content.schema.json",
  "title": "Santa's Naughty Book – content.json",
  "description": "Branding, Stimme, Sprache, Storyline und Gästeliste für Santa AI. Alle Felder sind optional.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer"
    },
    "language": {
      "description": "Sprache, in der Santa spricht: gsw = Schwiizerdütsch, de = Hochdeutsch, en = English",
      "enum": [
        "gsw",
        "de",
        "en"
      ]
    },
    "uiLanguage": {
      "description": "Sprache der Bedienoberfläche und des Buchs",
      "enum": [
        "de",
        "en"
      ]
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preset": {
          "enum": [
            "classic",
            "ubs"
          ],
          "description": "Farbschema"
        },
        "name": {
          "type": "string",
          "description": "Name neben dem Titel und auf der Titelkarte"
        },
        "logo": {
          "type": "string",
          "description": "Pfad zur offiziellen Logodatei, z. B. brand/logo.svg (Datei in public/brand/ ablegen)"
        },
        "primary": {
          "type": "string",
          "description": "Hauptfarbe (Buttons), z. B. #E60000"
        },
        "primaryText": {
          "type": "string"
        },
        "accent": {
          "type": "string"
        },
        "font": {
          "type": "string",
          "description": "CSS font-family"
        },
        "presents": {
          "type": "string",
          "description": "Zeile über dem Filmtitel, z. B. „UBS präsentiert“"
        }
      }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": [
            "elevenlabs",
            "browser"
          ]
        },
        "voiceId": {
          "type": "string",
          "description": "ElevenLabs Voice-ID (leer = Server-Standard ELEVENLABS_VOICE_ID oder „George“)"
        },
        "modelId": {
          "type": "string",
          "description": "z. B. eleven_multilingual_v2"
        },
        "stability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "similarity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "style": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "speed": {
          "type": "number",
          "minimum": 0.7,
          "maximum": 1.2
        }
      }
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "description": "Filmtitel auf der ersten Titelkarte"
        },
        "subtitle": {
          "type": "string"
        },
        "prologue": {
          "type": "string",
          "description": "Erzählung am Anfang (sonst Standardtext)"
        },
        "greeting": {
          "type": "string",
          "description": "Begrüssung (sonst Standardtext)"
        },
        "epilogue": {
          "type": "string",
          "description": "Erzählung vor dem Abschied"
        },
        "farewell": {
          "type": "string",
          "description": "Letzte Worte"
        },
        "chapterLabel": {
          "type": "string",
          "description": "z. B. „Kapitel“"
        },
        "endTitle": {
          "type": "string",
          "description": "Abspann-Titel"
        },
        "music": {
          "type": "boolean",
          "description": "Spieldose „Stille Nacht“ im Vor- und Abspann"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "santa": {
          "type": "string",
          "description": "Unterschrift im Buch"
        }
      }
    },
    "guests": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80
          },
          "verdict": {
            "enum": [
              "nice",
              "naughty",
              "undecided"
            ]
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "0 = engelsgleich … 100 = Kohle"
          },
          "nice": {
            "description": "Gute Taten – Liste oder Text mit Zeilenumbrüchen",
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "string"
              }
            ]
          },
          "naughty": {
            "description": "Missetaten – Liste oder Text mit Zeilenumbrüchen",
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "string"
              }
            ]
          },
          "story": {
            "type": "string",
            "maxLength": 8000,
            "description": "Eigene Geschichte – Santa liest sie wörtlich vor"
          },
          "title": {
            "type": "string",
            "maxLength": 120,
            "description": "Kapitel-Untertitel auf der Titelkarte, z. B. „Der sparsame Superbanker“"
          }
        }
      }
    }
  }
}